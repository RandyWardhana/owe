# Cloud sync — optional. Without these, owe runs fully offline (localStorage only)
# and shared "paid" state is not synced across devices.
#
# Storage is Cloudflare D1, reached through the owe-db Worker in worker/.
# See worker/README.md for the one-time setup.

# Tells the browser that sharing + history backup are available. No secrets here.
NEXT_PUBLIC_OWE_CLOUD=1

# Server-only. The deployed Worker URL and the shared secret it checks.
OWE_DB_URL=https://owe-db.YOURNAME.workers.dev
OWE_DB_SECRET=the-value-you-passed-to-wrangler-secret-put

# Cloud receipt OCR (OCR.space) — required for scanning (it runs server-side, so
# scanning needs a connection; offline the scan buttons show a hint instead). The
# built-in "helloworld" demo key works out of the box but is rate-limited — get
# your own free key (25k/month) at https://ocr.space/ocrapi for reliability.
OCRSPACE_API_KEY=helloworld
